# ==========================================
# TravelGuide Environment Variables
# ==========================================

# Anthropic Claude API Key (for grounded itinerary sequencing)
ANTHROPIC_API_KEY=

# Google Places API Key (Autocomplete, Nearby Search, Details, Photos)
GOOGLE_PLACES_API_KEY=

# Supabase (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Booking.com Affiliate Partner ID (Appended to outbound stay links)
NEXT_PUBLIC_BOOKING_AFFILIATE_ID=travelguide_in

# App URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
